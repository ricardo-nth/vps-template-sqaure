---
import SiteLayout from '@layouts/SiteLayout.astro';
import { getEntry } from 'astro:content';
import PageHero from '@components/PageHero.astro';
import Icon from '@components/Icon.astro';
import WhyChooseUs from '@components/WhyChooseUs.astro';
import CqcJourney from '@components/CqcJourney.astro';
import ContactSection from '@components/ContactSection.astro';
import { getSquareImage } from '@/lib/content/imageRegistry';

const complexCareEntry = await getEntry('squareComplexCare', 'default');
const complexCareDomEntry = await getEntry('squareComplexCare', 'dom-care');
if (!complexCareEntry) {
  throw new Error('Missing content entry: squareComplexCare/default');
}
if (!complexCareDomEntry) {
  throw new Error('Missing content entry: squareComplexCare/dom-care');
}

const metadata = complexCareEntry.data.metadata;
const profiles = [
  { key: 'supported-living', content: complexCareEntry.data },
  { key: 'dom-care', content: complexCareDomEntry.data },
] as const;
---

<SiteLayout metadata={metadata}>
  <div data-care-profile-switcher>
    {profiles.map(({ key, content }) => (
      <div data-care-profile-panel={key} class:list={{ hidden: key !== 'supported-living' }}>
        <PageHero
          heading={content.hero.heading}
          subheading={content.hero.subheading}
          profileContent={content.hero.profileContent}
          primaryCtaText={content.hero.primaryCtaText}
          primaryCtaHref={content.hero.primaryCtaHref}
          secondaryCtaText={content.hero.secondaryCtaText}
          secondaryCtaHref={content.hero.secondaryCtaHref}
          imageSrc={getSquareImage(content.hero.imageKey)}
          imageAlt={content.hero.imageAlt}
        />

        {/* Outcomes Snapshot */}
        <section class="bg-secondary/30 py-24 lg:py-32">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-20">
              <p class="text-sm font-bold uppercase tracking-widest text-primary mb-3">Key Outcomes</p>
              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground tracking-tight text-balance mb-6 font-serif">
                {content.outcomesSnapshot.heading}
              </h2>
              <p class="text-xl text-muted-foreground leading-relaxed">
                {content.outcomesSnapshot.intro}
              </p>
            </div>
            <div class="grid gap-8 md:grid-cols-3">
              {content.outcomesSnapshot.stats.map((stat) => (
                <div class="group bg-card p-10 border border-border hover:border-accent transition-all duration-300">
                  <p class="text-4xl font-bold text-primary mb-4 font-serif">{stat.value}</p>
                  <p class="text-lg font-semibold text-foreground mb-2">{stat.label}</p>
                  <p class="text-muted-foreground leading-relaxed">{stat.detail}</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        {/* Service Fit */}
        <section class="bg-background py-24 lg:py-32">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-20">
              <p class="text-sm font-bold uppercase tracking-widest text-primary mb-3">{content.serviceFit.badgeLabel}</p>
              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground tracking-tight text-balance mb-6 font-serif">
                {content.serviceFit.heading}
              </h2>
              <p class="text-xl text-muted-foreground leading-relaxed">
                {content.serviceFit.intro}
              </p>
            </div>

            <div class="grid gap-8 lg:grid-cols-2">
              <div class="group bg-card p-10 border border-border hover:border-accent transition-all duration-300">
                <div class="flex items-center gap-4 mb-8">
                  <div class="inline-flex h-12 w-12 items-center justify-center bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground transition-all duration-300">
                    <Icon name="tabler:circle-check" class="h-6 w-6" aria-hidden={true} />
                  </div>
                  <h3 class="text-2xl font-bold text-foreground font-serif">{content.serviceFit.suitableForTitle}</h3>
                </div>
                <ul class="space-y-4">
                  {content.serviceFit.suitableFor.map((item) => (
                    <li class="flex gap-3 text-muted-foreground leading-relaxed">
                      <Icon name="tabler:check" class="mt-1 h-5 w-5 shrink-0 text-primary" aria-hidden={true} />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="group bg-card p-10 border border-border hover:border-accent transition-all duration-300">
                <div class="flex items-center gap-4 mb-8">
                  <div class="inline-flex h-12 w-12 items-center justify-center bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground transition-all duration-300">
                    <Icon name="tabler:route-off" class="h-6 w-6" aria-hidden={true} />
                  </div>
                  <h3 class="text-2xl font-bold text-foreground font-serif">{content.serviceFit.alternativeSupportTitle}</h3>
                </div>
                <ul class="space-y-4">
                  {content.serviceFit.alternativeSupport.map((item) => (
                    <li class="flex gap-3 text-muted-foreground leading-relaxed">
                      <Icon name="tabler:minus" class="mt-1 h-5 w-5 shrink-0 text-primary" aria-hidden={true} />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </section>

        {/* First 30 Days */}
        <section class="bg-muted/30 py-24 lg:py-32">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-20">
              <p class="text-sm font-bold uppercase tracking-widest text-primary mb-3">Onboarding</p>
              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground tracking-tight text-balance mb-6 font-serif">
                {content.firstThirtyDays.heading}
              </h2>
              <p class="text-xl text-muted-foreground leading-relaxed">
                {content.firstThirtyDays.intro}
              </p>
            </div>

            <div class="grid gap-8 md:grid-cols-3">
              {content.firstThirtyDays.milestones.map((milestone) => (
                <div class="group bg-card p-10 border border-border hover:border-accent transition-all duration-300">
                  <div class="flex items-center justify-between gap-3 mb-6">
                    <span class="inline-flex items-center border border-primary px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary">
                      {milestone.dayRange}
                    </span>
                    <div class="inline-flex h-10 w-10 items-center justify-center bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground transition-all duration-300">
                      <Icon name={milestone.icon} class="h-5 w-5" aria-hidden={true} />
                    </div>
                  </div>
                  <h3 class="text-xl font-bold text-foreground mb-3 font-serif group-hover:text-primary transition-colors">
                    {milestone.title}
                  </h3>
                  <p class="text-muted-foreground leading-relaxed">
                    {milestone.description}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </section>

        <WhyChooseUs
          eyebrow={content.whyChooseUs.eyebrow}
          heading={content.whyChooseUs.heading}
          intro={content.whyChooseUs.intro}
          id={content.whyChooseUs.id}
          points={content.whyChooseUs.points}
        />

        <CqcJourney
          badgeLabel={content.cqcJourney.badgeLabel}
          heading={content.cqcJourney.heading}
          subheading={content.cqcJourney.subheading}
          steps={content.cqcJourney.steps}
        />

        {/* FAQ Section */}
        <section class="bg-background py-24 lg:py-32">
          <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-20">
              <p class="text-sm font-bold uppercase tracking-widest text-primary mb-3">FAQs</p>
              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground tracking-tight text-balance mb-6 font-serif">
                {content.faqSection.heading}
              </h2>
              <p class="text-xl text-muted-foreground leading-relaxed">
                {content.faqSection.intro}
              </p>
            </div>
            <div class="space-y-4">
              {content.faqSection.items.map((item) => (
                <details class="group border border-border bg-card p-6 hover:border-accent transition-all duration-300">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-foreground font-serif text-lg">
                    <span>{item.question}</span>
                    <Icon name="tabler:chevron-down" class="h-5 w-5 shrink-0 text-primary transition-transform group-open:rotate-180" aria-hidden={true} />
                  </summary>
                  <p class="mt-4 text-muted-foreground leading-relaxed">{item.answer}</p>
                </details>
              ))}
            </div>
          </div>
        </section>

        <ContactSection
          heading={content.contactSection.heading}
          intro={content.contactSection.intro}
          phoneLabel={content.contactSection.phoneLabel}
          phoneHref={content.contactSection.phoneHref}
          emailLabel={content.contactSection.emailLabel}
          emailHref={content.contactSection.emailHref}
          emailButtonText={content.contactSection.emailButtonText}
          address={content.contactSection.address}
          officeTitle={content.contactSection.officeTitle}
          officeDirectionsText={content.contactSection.officeDirectionsText}
          officeDirectionsHref={content.contactSection.officeDirectionsHref}
          hoursTitle={content.contactSection.hoursTitle}
          officeHours={content.contactSection.officeHours}
          hoursNote={content.contactSection.hoursNote}
        />
      </div>
    ))}
  </div>
</SiteLayout>
