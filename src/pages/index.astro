---
/**
 * index.astro - Homepage
 *
 * Demonstrates the full implementation of:
 * - Two-tier layout system (TechnicalLayout → SiteLayout)
 * - SEO optimization with meta tags and schema markup
 * - Image optimization with Astro's Image component
 * - Tailwind CSS styling
 * - Performance best practices
 */

import SiteLayout from '../layouts/SiteLayout.astro';

// Components
import Hero from '../components/Hero.astro';
import ServicesOverview from '../components/ServicesOverview.astro';
import AboutUs from '../components/AboutUs.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import TeamSection from '../components/TeamSection.astro';
import ContactSection from '../components/ContactSection.astro';

// Page metadata - Update for your business
const metadata = {
  title: 'Home - [Business Name]',
  description: '[Your business description - what services you provide and who you serve]',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Home - [Business Name]',
    description: '[Your business description - what services you provide and who you serve]',
  },
};
---

<SiteLayout metadata={metadata}>

  <!-- Hero Section -->
  <Hero />

  <!-- Services Section -->
  <ServicesOverview
    eyebrow="Our Services"
  />

  <!-- About Us Section -->
  <AboutUs
    eyebrow="About Us"
  />

  <!-- Why Choose Us Section -->
  <WhyChooseUs
    eyebrow="Why Choose Us"
    intro="[Your value proposition - why clients should choose your services over competitors]"
    points={[
      {
        title: "[Differentiator 1]",
        description: "[Description of your first key differentiator or benefit]",
        iconName: "tabler:shield-check"
      },
      {
        title: "[Differentiator 2]",
        description: "[Description of your second key differentiator or benefit]",
        iconName: "tabler:user-heart"
      },
      {
        title: "[Differentiator 3]",
        description: "[Description of your third key differentiator or benefit]",
        iconName: "tabler:users-group"
      },
      {
        title: "[Differentiator 4]",
        description: "[Description of your fourth key differentiator or benefit]",
        iconName: "tabler:certificate"
      }
    ]}
  />

  <!-- Team Section -->
  <TeamSection
    eyebrow="Our Team"
    heading="[Your Team Heading]"
    intro="[Brief description of your team and their dedication to clients]"
  />

  <!-- Contact Section -->
  <ContactSection
    phoneLabel="[Your Phone]"
    phoneHref="tel:[YourPhoneNumber]"
    address="[Your City, Region]"
  />

</SiteLayout>
